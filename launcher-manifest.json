{
  "schema_version": 2,
  "mod_info": {
    "name": "RVThereYetHeadTracking",
    "version": "0.3.0",
    "game_id": "rv-there-yet"
  },
  "strategy": "Shim",
  "delivery_mode": "manifest",

  "loader": {
    "seed": [
      { "target": "HeadTracking.ini", "anchor": "exe_dir", "content_b64": "" }
    ]
  },

  "files": [
    { "source": "plugins/dxgi.dll", "target": "dxgi.dll", "anchor": "exe_dir", "backup": true }
  ],

  "runtime_requirements": [
    {
      "id": "dxgi-proxy-original",
      "type": "system-file-copy",
      "source": "%WINDIR%/System32/dxgi.dll",
      "target": "dxgi_orig.dll",
      "anchor": "exe_dir",
      "required": true,
      "reason": "The mod ships as a dxgi.dll proxy planted next to the game exe. The real Windows dxgi.dll must be captured alongside it as dxgi_orig.dll so the proxy can forward every DXGI export to it; without it the game cannot create its swapchain and fails to launch. The file is not redistributable, so it is captured from the user's own System32 at install time."
    }
  ],

  "dependencies": []
}
